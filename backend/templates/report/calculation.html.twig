{% extends 'base.html.twig' %}

{% block title %}Split Fairly - Report{% endblock %}

{% block stylesheets %}
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            background: #fff;
            color: #1a1a1a;
            font-size: 11pt;
            line-height: 1.5;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell", sans-serif;
        }

        @page {
            size: A4 portrait;
            margin: 10mm 15mm;
        }

        h1 {
            font-size: 22pt;
            font-weight: 600;
            margin: 0 0 4mm 0;
            color: #000;
        }

        h2 {
            font-size: 12pt;
            font-weight: 600;
            margin: 8mm 0 4mm 0;
            color: #1a1a1a;
            border-bottom: 1pt solid #e5e5e5;
            padding-bottom: 2mm;
        }

        p {
            margin: 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

        td, th {
            padding: 3mm;
            text-align: left;
            border: none;
        }

        .header {
            text-align: center;
            margin-bottom: 6mm;
            padding-bottom: 4mm;
            border-bottom: 1.5pt solid #333;
        }

        .timestamp {
            font-size: 9pt;
            color: #666;
            margin-top: 2mm;
        }

        .settlement-section {
            margin-bottom: 10mm;
            padding: 4mm;
            background: #f9f9f9;
            border-radius: 2pt;
        }

        .settlement-table {
            width: 100%;
            margin-top: 3mm;
        }

        .settlement-table td {
            width: 33.33%;
            padding: 3mm;
            text-align: center;
            vertical-align: top;
            border-bottom: 1pt solid #e5e5e5;
        }

        .settlement-label {
            font-size: 9pt;
            font-weight: 600;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 2mm;
            display: block;
        }

        .settlement-value {
            font-size: 11pt;
            font-weight: 600;
            color: #1a1a1a;
        }

        .settlement-amount {
            color: #2d7d2d;
            font-weight: 700;
        }

        .users-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6mm;
            margin-top: 6mm;
        }

        .user-section {
            padding: 4mm;
            background: #fafafa;
            border-left: 2pt solid #ddd;
            page-break-inside: avoid;
        }

        .user-email {
            font-size: 11pt;
            font-weight: 600;
            color: #000;
            margin-bottom: 4mm;
            padding-bottom: 2mm;
            border-bottom: 1pt solid #ddd;
        }

        .expense-type-group {
            margin-bottom: 5mm;
        }

        .expense-type-heading {
            font-size: 9pt;
            font-weight: 600;
            color: #555;
            text-transform: uppercase;
            margin-bottom: 2mm;
            letter-spacing: 0.3pt;
        }

        .expense-item {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 2mm;
            padding: 2mm 0;
            border-bottom: 0.5pt solid #eee;
            font-size: 10pt;
            align-items: center;
        }

        .expense-what {
            font-weight: 500;
            color: #1a1a1a;
        }

        .expense-amount {
            text-align: right;
            font-weight: 600;
            color: #1a1a1a;
            white-space: nowrap;
        }

        .category-total {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 2mm;
            padding: 2mm 0;
            margin-top: 2mm;
            border-top: 1pt solid #999;
            font-size: 10pt;
            font-weight: 600;
            color: #1a1a1a;
        }

        .category-total-amount {
            text-align: right;
            white-space: nowrap;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="header">
        <h1>Split Fairly Report</h1>
        <p class="timestamp">Generated {{ "now"|date("F j, Y \\a\\t H:i") }}</p>
    </div>

    <div class="settlement-section">
        <h2>Settlement Summary</h2>
        <table class="settlement-table">
            <tr>
                <td>
                    <span class="settlement-label">From</span>
                    <div class="settlement-value">{{ compensation.from }}</div>
                </td>
                <td>
                    <span class="settlement-label">Amount</span>
                    <div class="settlement-value settlement-amount">{{ compensation.settlement.value|number_format(2) }} {{ compensation.settlement.currency }}</div>
                </td>
                <td>
                    <span class="settlement-label">To</span>
                    <div class="settlement-value">{{ compensation.to }}</div>
                </td>
            </tr>
        </table>
    </div>

    <h2>Expenses by User</h2>
    <div class="users-container">
        {% for expenses in expenses %}
            <div class="user-section">
                <p class="user-email">{{ expenses.userEmail }}</p>

                {% set expensesByType = {} %}
                {% for expense in expenses.expenses %}
                    {% if expensesByType[expense.type] is not defined %}
                        {% set expensesByType = expensesByType|merge({(expense.type): []}) %}
                    {% endif %}
                    {% set expensesByType = expensesByType|merge({(expense.type): expensesByType[expense.type]|merge([expense])}) %}
                {% endfor %}

                {% for type, typeExpenses in expensesByType %}
                    <div class="expense-type-group">
                        <div class="expense-type-heading">{{ type }}</div>
                        {% for expense in typeExpenses %}
                            <div class="expense-item">
                                <div class="expense-what">{{ expense.what }}</div>
                                <div class="expense-amount">{{ expense.price.value|number_format(2) }} {{ expense.price.currency }}</div>
                            </div>
                        {% endfor %}
                        {% set totalAmount = 0 %}
                        {% set currency = typeExpenses[0].price.currency %}
                        {% for expense in typeExpenses %}
                            {% set totalAmount = totalAmount + expense.price.value %}
                        {% endfor %}
                        <div class="category-total">
                            <div>Total</div>
                            <div class="category-total-amount">{{ totalAmount|number_format(2) }} {{ currency }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endblock %}
