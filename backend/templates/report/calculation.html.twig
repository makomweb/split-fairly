{% extends 'base.html.twig' %}

{% block title %}Split Fairly - Report{% endblock %}

{% block stylesheets %}
    <style>
        * {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 11px;
            line-height: 1.6;
            color: #333;
            background: white;
            width: 210mm;
            margin: 0;
            padding: 15mm;
        }

        .page {
            width: 180mm;
        }

        .header {
            text-align: center;
            margin-bottom: 12mm;
            padding-bottom: 8mm;
            border-bottom: 2px solid #333;
        }

        .header h1 {
            font-size: 26px;
            margin: 0 0 3mm 0;
            color: #000;
        }

        .timestamp {
            font-size: 9px;
            color: #666;
            margin: 0;
        }

        .settlement-box {
            background: #f9f9f9;
            padding: 6mm 8mm;
            margin: 4mm 0;
            border-left: 3px solid #333;
        }

        .settlement-summary {
            font-size: 11px;
            line-height: 1.7;
            color: #333;
        }

        .settlement-summary strong {
            font-weight: bold;
            color: #000;
        }

        .amount-highlight {
            font-size: 14px;
            font-weight: bold;
            color: #2d7d2d;
        }

        .expenses-section {
            margin-top: 6mm;
        }

        .section-title {
            font-size: 13px;
            font-weight: bold;
            margin: 8mm 0 5mm 0;
            color: #000;
            border-bottom: 1px solid #ddd;
            padding-bottom: 3mm;
        }

        .user-section {
            margin-bottom: 6mm;
        }

        .user-header {
            font-size: 11px;
            font-weight: bold;
            color: #000;
            margin: 0 0 4mm 0;
        }

        .expense-line {
            display: table;
            width: 100%;
            margin-bottom: 2mm;
            font-size: 10px;
        }

        .expense-category {
            display: table-cell;
            width: 25%;
            color: #666;
            padding-right: 2mm;
        }

        .expense-description {
            display: table-cell;
            width: 55%;
            color: #333;
            padding: 0 3mm;
        }

        .expense-amount {
            display: table-cell;
            width: 20%;
            text-align: right;
            color: #333;
            font-weight: bold;
        }

        .user-total {
            display: table;
            width: 100%;
            margin-top: 2mm;
            padding-bottom: 3mm;
            border-bottom: 1px solid #ddd;
            font-size: 10px;
            font-weight: bold;
        }

        .total-label {
            display: table-cell;
            width: 80%;
            color: #000;
        }

        .total-value {
            display: table-cell;
            width: 20%;
            text-align: right;
            color: #000;
        }
    </style>
{% endblock %}

{% block body %}
<div class="page">
    <div class="header">
        <h1>Split Fairly Report</h1>
        <p class="timestamp">{{ "now"|date("d F Y") }}</p>
    </div>

    <div class="settlement-box">
        <div class="settlement-summary">
            <strong>{{ compensation.from }}</strong> owes <strong>{{ compensation.to }}</strong> <span class="amount-highlight">{{ compensation.settlement.value|number_format(2) }} {{ compensation.settlement.currency }}</span>.
        </div>
    </div>

    <div class="expenses-section">
        <div class="section-title">Expense Details</div>
        
        {% for expenses in expenses %}
            <div class="user-section">
                <div class="user-header">{{ expenses.userEmail }}</div>
                
                {% set expensesByType = {} %}
                {% for expense in expenses.expenses %}
                    {% if expensesByType[expense.type] is not defined %}
                        {% set expensesByType = expensesByType|merge({(expense.type): []}) %}
                    {% endif %}
                    {% set expensesByType = expensesByType|merge({(expense.type): expensesByType[expense.type]|merge([expense])}) %}
                {% endfor %}

                {% for type, typeExpenses in expensesByType %}
                    {% set totalAmount = 0 %}
                    {% set currency = typeExpenses[0].price.currency %}
                    {% for expense in typeExpenses %}
                        {% set totalAmount = totalAmount + expense.price.value %}
                    {% endfor %}

                    {% for expense in typeExpenses %}
                        <div class="expense-line">
                            <div class="expense-category">{{ type }}</div>
                            <div class="expense-description">{{ expense.what }}</div>
                            <div class="expense-amount">{{ expense.price.value|number_format(2) }}</div>
                        </div>
                    {% endfor %}
                    
                    <div class="user-total">
                        <div class="total-label">{{ type }} Total</div>
                        <div class="total-value">{{ totalAmount|number_format(2) }} {{ currency }}</div>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
