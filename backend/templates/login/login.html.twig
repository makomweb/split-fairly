{% extends 'base.html.twig' %}

{% block title %}Split Fairly - Login{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="card">
            <div class="card-body">
                {% if error %}
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle"></i>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        You are logged in as <strong>{{ app.user.userIdentifier }}</strong>
                        <a href="{{ path('app.logout') }}" class="alert-link">Sign out</a>
                    </div>
                {% endif %}

                <h3>Welcome Back</h3>
                <p class="card-subtitle">Sign in to your account</p>

                <form method="post" action="{{ path('app.login_check') }}">
                    <div class="form-group">
                        <label for="username">Email Address</label>
                        <input 
                            type="email" 
                            value="{{ last_username }}" 
                            name="_username" 
                            id="username" 
                            class="form-control" 
                            placeholder="you@example.com"
                            autocomplete="email" 
                            required 
                            autofocus>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input 
                            type="password" 
                            name="_password" 
                            id="password" 
                            class="form-control" 
                            placeholder="••••••••"
                            autocomplete="current-password" 
                            required>
                    </div>

                    <div class="checkbox">
                        <input type="checkbox" name="_remember_me" id="_remember_me">
                        <label for="_remember_me">Keep me signed in</label>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="btn btn-primary" type="submit">
                        <i class="fas fa-sign-in-alt"></i> Sign In
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
